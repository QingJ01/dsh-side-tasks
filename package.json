{
  "name": "dsh-side-tasks-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "pnpm --filter dsh-side-tasks build",
    "typecheck": "node packages/plugins/side-tasks/scripts/prebuild.mjs && tsc -b packages/plugins/side-tasks/tsconfig.host.json packages/plugins/side-tasks/tsconfig.client.json --pretty",
    "test": "pnpm --filter dsh-side-tasks build && vitest run",
    "check": "pnpm test"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-loader": "0.2.1-rc.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "jsdom": "29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
