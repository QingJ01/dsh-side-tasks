@@ -0,0 +1,174 @@
+import { mkdtemp, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { pathToFileURL } from 'node:url'
+import { afterEach, describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import Loader, { type ModuleLoaderV2 } from '@deepseek-ai/cordis-plugin-loader'
+import Include from '@deepseek-ai/cordis-plugin-include'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import LlmRuntime, { createUserMessage } from '@deepseek-ai/dsh-llm'
+import SessionStore, { SessionId } from '@deepseek-ai/dsh-session'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import * as JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+import Storage from '@deepseek-ai/dsh-storage'
+import * as StorageDomain from '@deepseek-ai/dsh-storage-domain'
+import * as JsonStorage from '@deepseek-ai/dsh-storage-json'
+import WorkspaceRegistry from '@deepseek-ai/dsh-workspace'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime from '@deepseek-ai/dsh-tools'
+import { MockAdapter, textResponse } from './mock-adapter.ts'
+
+let root: string | undefined
+let context: Context | undefined
+
+function sourceModuleLoader(importModule: (specifier: string) => Promise<unknown>): ModuleLoaderV2 {
+  return {
+    version: 'v2',
+    import: importModule,
+    loadCache: new Map(),
+    register(): never { throw new Error('unexpected module hook registration') },
+    getOrCreateModuleJob(): never { throw new Error('unexpected module job creation') },
+    resolveSync(): never { throw new Error('unexpected synchronous module resolution') },
+    load(): never { throw new Error('unexpected module load') },
+  }
+}
+
+afterEach(async () => {
+  await context?.fiber.dispose()
+  context = undefined
+  if (root !== undefined) await rm(root, { recursive: true, force: true })
+  root = undefined
+})
+
+async function loadHarness(): Promise<Context> {
+  root = await mkdtemp(join(tmpdir(), 'dsh-sidechat-loader-'))
+  const configPath = join(root, 'cordis.yml')
+  await writeFile(configPath, [
+    "- name: '@deepseek-ai/dsh-llm'",
+    "- name: '@deepseek-ai/dsh-session'",
+    "- name: '@deepseek-ai/dsh-session-projection'",
+    "- name: '@deepseek-ai/dsh-system-prompt'",
+    "- name: '@deepseek-ai/dsh-tools'",
+    "- name: '@deepseek-ai/dsh-agent'",
+    "- name: '@deepseek-ai/dsh-session-persistence-jsonl'",
+    '  config:',
+    `    root: ${JSON.stringify(join(root, 'sessions'))}`,
+    "- name: '@deepseek-ai/dsh-agent-loop'",
+    '  config:',
+    '    agents: []',
+    "- name: '@deepseek-ai/dsh-storage'",
+    "- name: '@deepseek-ai/dsh-storage-json'",
+    '  config:',
+    `    root: ${JSON.stringify(join(root, 'storage'))}`,
+    "- name: '@deepseek-ai/dsh-storage-domain'",
+    '  config:',
+    '    backend: json',
+    "- name: '@deepseek-ai/dsh-workspace'",
+    '',
+  ].join('\n'))
+
+  context = new Context()
+  context.baseUrl = pathToFileURL(root).href + '/'
+  await context.plugin(Loader)
+  context.loader.builtins.include = Include
+  const modules = new Map<string, unknown>([
+    ['@deepseek-ai/dsh-llm', LlmRuntime],
+    ['@deepseek-ai/dsh-session', SessionStore],
+    ['@deepseek-ai/dsh-session-projection', SessionProjectionRegistry],
+    ['@deepseek-ai/dsh-system-prompt', SystemPrompt],
+    ['@deepseek-ai/dsh-tools', ToolRuntime],
+    ['@deepseek-ai/dsh-agent', AgentRegistry],
+    ['@deepseek-ai/dsh-session-persistence-jsonl', JsonlSessionPersistence],
+    ['@deepseek-ai/dsh-agent-loop', AgentLoop],
+    ['@deepseek-ai/dsh-storage', Storage],
+    ['@deepseek-ai/dsh-storage-json', JsonStorage],
+    ['@deepseek-ai/dsh-storage-domain', StorageDomain],
+    ['@deepseek-ai/dsh-workspace', WorkspaceRegistry],
+  ])
+  context.loader.internal = sourceModuleLoader(async (specifier: string) => {
+    const module = modules.get(specifier)
+    if (module === undefined) throw new Error(`unexpected Loader import: ${specifier}`)
+    return module
+  })
+  await context.loader.create({
+    name: 'cordis:include',
+    config: { path: pathToFileURL(configPath).href },
+  })
+  await context.loader.await()
+  return context
+}
+
+function prompt(agent: { followup(message: ReturnType<typeof createUserMessage>): void }, text: string): void {
+  agent.followup(createUserMessage({ content: [{ type: 'text', text }], source: { kind: 'user' } }))
+}
+
+describe('sidechat root through the real Loader composition', () => {
+  it('completes, follows up, cold-resumes, and archives without touching a live source root', { timeout: 60_000 }, async () => {
+    const ctx = await loadHarness()
+    const cwd = root ?? process.cwd()
+    const adapter = new MockAdapter([
+      textResponse('first answer'),
+      textResponse('second answer'),
+      textResponse('resumed answer'),
+      'hang',
+    ])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const sourceId = SessionId('source-main')
+    const sidechatId = SessionId('independent-sidechat')
+    const source = await ctx.agents.create({
+      sessionId: sourceId,
+      meta: { cwd },
+      agentOptions: { provider: 'mock', model: 'mock' },
+    })
+    const sourceRegistryIdentity = ctx.agents.get(sourceId)
+    const sourceEvents = source.agent.session.ownEvents()
+    const sidechat = await ctx.agents.create({
+      sessionId: sidechatId,
+      meta: { origin: 'sidechat', cwd },
+      agentOptions: { provider: 'mock', model: 'mock' },
+    })
+
+    expect(sidechat.agent.session.header.origin).toBe('sidechat')
+    expect(sidechat.agent.session.header.parentSession).toBeUndefined()
+    prompt(sidechat.agent, 'first prompt')
+    await sidechat.agent.whenIdle()
+    prompt(sidechat.agent, 'follow-up prompt')
+    await sidechat.agent.whenIdle()
+    await sidechat.dispose()
+
+    await expect(ctx.agents.resume({
+      resumeSessionId: sidechatId,
+      parentAgent: source.agent,
+      agentOptions: { provider: 'mock', model: 'mock' },
+    })).rejects.toThrow('sidechat agents cannot resume under a parent Agent')
+    const resumed = await ctx.agents.resume({
+      resumeSessionId: sidechatId,
+      agentOptions: { provider: 'mock', model: 'mock' },
+    })
+    expect(resumed.agent.session.header.origin).toBe('sidechat')
+    prompt(resumed.agent, 'cold-resumed prompt')
+    await resumed.agent.whenIdle()
+
+    const running = new Promise<void>((resolve) => {
+      const dispose = ctx.on('agent/status', ({ agent: observed, status }) => {
+        if (observed === resumed.agent && status === 'running') {
+          dispose()
+          resolve()
+        }
+      })
+    })
+    prompt(resumed.agent, 'stop me during generation')
+    await running
+    await ctx.workspaceRegistry.archiveSession(sidechatId, { stopActivity: true })
+    await resumed.agent.whenIdle()
+
+    expect(ctx.workspaceRegistry.archivedSessionIds).toContain(sidechatId)
+    expect(adapter.requests).toHaveLength(4)
+    expect(source.agent.session.ownEvents()).toEqual(sourceEvents)
+    expect(ctx.agents.get(sourceId)).toBe(sourceRegistryIdentity)
+    expect(source.agent.status).toBe('idle')
+    await source.dispose()
+  })
+})
